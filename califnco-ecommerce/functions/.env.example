# Razorpay test checkout. The key ID is public; keep the secret in Secret Manager.
RAZORPAY_KEY_ID=rzp_test_replace_with_dashboard_key_id

# Brevo SMTP transactional email (recommended).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_brevo_smtp_login
SMTP_FROM=Califnco Orders <orders@your-verified-domain.example>

# Optional HTTP SMS gateway adapter. Only configured gateways are called.
SMS_PROVIDER_URL=
SMS_FROM=

# Set RAZORPAY_KEY_SECRET, SMTP_PASSWORD, and SMS_PROVIDER_TOKEN as Functions
# secrets. For local emulators use functions/.secret.local; for deployed
# functions use `firebase functions:secrets:set SECRET_NAME`.
