# Copy to ai-automation/.env for local runs. Keep real values out of source control.

# Google AI Studio Gemini API key (free-tier model access depends on account/region).
GEMINI_API_KEY=AQ.Ab8RN6LeT835PRnsC-Yp0ecMq8vu-P8r-r-afKlubLhMCarPvw
GEMINI_MODEL=gemini-3.1-flash-lite

# Local Firestore Emulator settings. Remove these two lines when using a real
# Firebase project and configure FIREBASE_SERVICE_ACCOUNT_JSON instead.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GCLOUD_PROJECT=demo-califnco

# Firebase service-account JSON on one line or as valid multiline JSON.
# The service account needs Firestore read/write permissions.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloudinary unsigned upload preset. Configure it to accept only images <= 10 MB.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Local WAHA Docker service (use a secondary WhatsApp number).
WAHA_BASE_URL=http://127.0.0.1:3008
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# Meta Graph API credentials for a linked Instagram Professional account.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v23.0

# Daily workflow policy. Admin Firestore setting automationSettings/instagram.autoApprove
# overrides this default. False creates drafts that an admin must approve.
AUTO_APPROVE_INSTAGRAM_POSTS=false
RECENT_POST_DAYS=30
